<Window x:Class="ClaudeAccountSwitcher.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeAccountSwitcher"
        Title="Backup &amp; Restore" Width="860" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate x:Key="ItemCard" DataType="{x:Type local:BackupItemVm}">
            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="{StaticResource AmberSoftBrush}"
                                    Visibility="{Binding Sensitive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="secrets" Style="{StaticResource ChipText}" Foreground="{StaticResource AmberBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Top" Margin="16,1,0,0" TextAlignment="Right" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#5A3A30" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabCreate" Style="{StaticResource SegmentRadio}" GroupName="tab" IsChecked="True" Checked="OnTab">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Create backup" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabRestore" Style="{StaticResource SegmentRadio}" GroupName="tab" Checked="OnTab">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Restore backup" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RunningNote" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource AmberBrush}" FontSize="12" Visibility="Collapsed"
                           Text="⚠ Claude is running" />
            </DockPanel>
        </Border>

        <!-- ============ Create ============ -->
        <DockPanel x:Name="CreatePanel" Grid.Row="1" Margin="22,18,22,18">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Back up everything Claude needs" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="One zip file with your sessions of every account, full conversation history and settings. Restore it after reinstalling Windows and everything comes back. Your project folders (the code itself) are not included." />
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="CreateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="OnCreate" MinWidth="190">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,1,10,0" />
                        <TextBlock Text="Create backup…" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CreateTotal" FontWeight="SemiBold" Text="Scanning…" />
                    <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Save it somewhere that survives the reinstall: another drive, a USB stick or cloud storage — not C:." />
                </StackPanel>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CreateItems" ItemTemplate="{StaticResource ItemCard}" />
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Restore ============ -->
        <DockPanel x:Name="RestorePanel" Grid.Row="1" Margin="22,18,22,18" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Restore from a backup" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Best on a fresh Windows: install Claude Desktop, quit it (tray icon → Quit), then restore here and start Claude again. Anything that gets replaced is copied aside first." />
            </StackPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnPickBackup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="12" />
                        <TextBlock Text="Choose backup file…" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="RestorePath" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"
                           TextTrimming="CharacterEllipsis" Text="No file chosen" />
            </DockPanel>

            <Border x:Name="ManifestCard" DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ManifestTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ManifestDetail" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ManifestWarning" Foreground="{StaticResource AmberBrush}" FontSize="12" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="RestoreButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="OnRestore"
                        MinWidth="170" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="13" Margin="0,1,10,0" />
                        <TextBlock Text="Restore" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="IF A FILE ALREADY EXISTS HERE" Style="{StaticResource SectionLabel}" Margin="2,0,0,5" />
                    <ComboBox x:Name="RestoreMode" Width="330" SelectedIndex="0">
                        <ComboBoxItem Content="Use the backup's copy (new Windows)" />
                        <ComboBoxItem Content="Keep mine, only add missing files" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RestoreItems" ItemTemplate="{StaticResource ItemCard}" />
                </ScrollViewer>
                <TextBlock x:Name="RestoreEmpty" Text="Choose a backup zip to see what's inside." Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DockPanel>

        <!-- ============ Progress overlay ============ -->
        <Border x:Name="Overlay" Grid.Row="0" Grid.RowSpan="2" Background="#D90E1014" Visibility="Collapsed">
            <Border Width="520" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderHoverBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="26,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ProgressTitle" FontSize="16" FontWeight="SemiBold" Text="Working…" />
                    <ProgressBar x:Name="Bar" Margin="0,18,0,0" Maximum="1" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock x:Name="ProgressCount" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </DockPanel>
                    <TextBlock x:Name="ProgressFile" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" FontSize="11"
                               FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Right"
                            Margin="0,18,0,0" MinWidth="96" Click="OnCancel" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
