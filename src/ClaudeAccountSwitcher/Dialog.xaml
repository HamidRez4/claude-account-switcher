<Window x:Class="ClaudeAccountSwitcher.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1"
            CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Border x:Name="IconBox" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="IconGlyph" Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20" />
            <ContentControl x:Name="Extra" Margin="0,14,0,0" />
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </StackPanel>
    </Border>
</Window>
