<Window x:Class="ClaudeAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeAccountSwitcher"
        xmlns:core="clr-namespace:SwitcherCore;assembly=SwitcherCore"
        Title="Claude Account Switcher" Width="1280" Height="800" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Account card -->
        <Style x:Key="AccountItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="#1F1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Session row -->
        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSessionRowClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7A4636" />
                                <Setter TargetName="Bd" Property="Background" Value="#1C1716" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SpaceOptionTemplate" DataType="{x:Type local:SpaceOption}">
            <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Avatar}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E68B6D" Offset="0" />
                                <GradientStop Color="#B85A3E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Claude Account Switcher" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Margin="8,0,0,1" FontSize="11" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource FaintBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="RootText" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                   Text="…" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="OnRefresh" ToolTip="Re-read sessions and accounts (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock Text="Refresh" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenFolder"
                            ToolTip="Open claude-code-sessions in Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock Text="Sessions folder" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenBackups"
                            ToolTip="Every transfer backs up the files it replaces or removes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock Text="Backups" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Banner ================= -->
        <Border x:Name="Banner" Grid.Row="1" Background="{StaticResource AmberSoftBrush}" BorderBrush="#3D3418"
                BorderThickness="0,0,0,1" Padding="22,9" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource AmberBrush}" FontSize="13" />
                <TextBlock x:Name="BannerText" Margin="10,0,0,0" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"
                           Text="Claude Desktop is running. Sessions you copy in show up after you restart it (tray icon → Quit)." />
            </StackPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,18,10,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,8,12">
                        <TextBlock Text="ACCOUNTS ON THIS PC" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AccountCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,10,8,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource FaintBrush}"
                               Text="Pick the account to copy FROM. Its sessions appear on the right." />
                    <ListBox x:Name="AccountsList" Background="Transparent" BorderThickness="0" Padding="0,0,8,0"
                             ItemContainerStyle="{StaticResource AccountItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnAccountChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AccountVm}">
                                <Grid ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{Binding Avatar}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="17"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,4,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ShortUuid}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Width="22" Height="20" FontSize="10"
                                                    Margin="2,0,0,0" ToolTip="Copy full UUID" Click="OnCopyUuid" Tag="{Binding Uuid}" />
                                        </StackPanel>
                                        <WrapPanel Margin="-6,8,0,0">
                                            <Border Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource GreenSoftBrush}"
                                                    Visibility="{Binding IsDesktopActive, Converter={StaticResource BoolVis}}"
                                                    ToolTip="The Claude desktop app is currently signed in with this account">
                                                <TextBlock Text="● Desktop" Style="{StaticResource ChipText}" Foreground="{StaticResource GreenBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource BlueSoftBrush}"
                                                    Visibility="{Binding IsCliActive, Converter={StaticResource BoolVis}}"
                                                    ToolTip="~/.claude.json (Claude Code CLI) is signed in with this account">
                                                <TextBlock Text="CLI" Style="{StaticResource ChipText}" Foreground="{StaticResource BlueBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LastActive}" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;" VerticalAlignment="Top"
                                            ToolTip="Set email / label by hand" Click="OnEditAlias" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Sessions -->
            <DockPanel Grid.Column="1" Margin="22,18,22,0">
                <!-- title row -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="LATEST SESSIONS" Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="SourceTitle" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" Text="—" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="OrgCombo" Width="290" Margin="0,0,10,0" Visibility="Collapsed"
                                  SelectionChanged="OnOrgChanged" ToolTip="This account has more than one org folder">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SpaceOption}">
                                    <TextBlock Text="{Binding OrgLabel}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Width="260">
                            <TextBox x:Name="SearchBox" Tag="Search title or folder…" Padding="30,0,10,0"
                                     TextChanged="OnSearchChanged" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                       Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- toolbar row -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Select:" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Button Style="{StaticResource LinkButton}" Content="All" Click="OnSelectAll" />
                        <Button Style="{StaticResource LinkButton}" Content="None" Click="OnSelectNone" />
                        <Button Style="{StaticResource LinkButton}" Content="Not in target" Click="OnSelectMissing"
                                ToolTip="Sessions the target account doesn't have yet" />
                        <Button Style="{StaticResource LinkButton}" Content="New or newer" Click="OnSelectNewer"
                                ToolTip="Missing in target, or newer here than the target's copy" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <CheckBox x:Name="ShowArchived" Content="Show archived" IsChecked="True" Foreground="{StaticResource MutedBrush}"
                                  Checked="OnFilterToggle" Unchecked="OnFilterToggle" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <ListBox x:Name="SessionsList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SessionItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Single" Padding="0,0,6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SessionRow}">
                                <Grid ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="700">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AmberBrush}"
                                                       Margin="0,0,6,0" Visibility="{Binding IsStarred, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource FaintBrush}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ProjectName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding Cwd}" Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding IsArchived, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Archived" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasModel, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Model}" Style="{StaticResource ChipText}" FontFamily="{StaticResource MonoFont}" FontWeight="Normal" />
                                        </Border>
                                        <Border x:Name="StateChip" Style="{StaticResource Chip}" ToolTip="{Binding StateTip}"
                                                Background="{StaticResource GreenSoftBrush}">
                                            <TextBlock x:Name="StateText" Text="{Binding StateText}" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource GreenBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding When}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TargetState.SourceNewer}">
                                        <Setter TargetName="StateChip" Property="Background" Value="{StaticResource BlueSoftBrush}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource BlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TargetState.Same}">
                                        <Setter TargetName="StateChip" Property="Background" Value="{StaticResource GraySoftBrush}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource FaintBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TargetState.TargetNewer}">
                                        <Setter TargetName="StateChip" Property="Background" Value="{StaticResource AmberSoftBrush}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource AmberBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE8F2;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource FaintBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" Text="No sessions here" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                   Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ================= Action bar ================= -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- target -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SEND TO ACCOUNT" Style="{StaticResource SectionLabel}" Margin="2,0,0,5" />
                    <ComboBox x:Name="TargetCombo" Width="320" ItemTemplate="{StaticResource SpaceOptionTemplate}"
                              SelectionChanged="OnTargetChanged" />
                </StackPanel>

                <!-- mode -->
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MODE" Style="{StaticResource SectionLabel}" Margin="2,0,0,5" />
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="2" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeCopy" Style="{StaticResource SegmentRadio}" GroupName="mode" IsChecked="True"
                                         Checked="OnModeChanged" ToolTip="Keep the sessions in the source account too">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" />
                                    <TextBlock Text="Copy" Margin="7,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeMove" Style="{StaticResource SegmentRadio}" GroupName="mode"
                                         Checked="OnModeChanged" ToolTip="Remove them from the source after copying">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8DE;" Style="{StaticResource Icon}" FontSize="11" />
                                    <TextBlock Text="Move" Margin="7,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- conflict -->
                <StackPanel Grid.Column="2" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="IF TARGET ALREADY HAS IT" Style="{StaticResource SectionLabel}" Margin="2,0,0,5" />
                    <ComboBox x:Name="ConflictCombo" Width="210" SelectedIndex="0">
                        <ComboBoxItem Content="Replace if mine is newer" />
                        <ComboBoxItem Content="Always replace" />
                        <ComboBoxItem Content="Skip it" />
                    </ComboBox>
                </StackPanel>

                <!-- status -->
                <TextBlock x:Name="StatusText" Grid.Column="3" Margin="22,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" />

                <!-- go -->
                <Button x:Name="TransferButton" Grid.Column="4" Style="{StaticResource AccentButton}" Click="OnTransfer"
                        VerticalAlignment="Bottom" MinWidth="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TransferLabel" Text="Copy 0 sessions" />
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Margin="10,1,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
